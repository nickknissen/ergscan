{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only m3-vue: a PR to move to each new npm release. Every other dependency is left alone.",
  "enabledManagers": ["npm"],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "matchDepNames": ["@nickknissen/m3-vue"],
      "enabled": true,
      "commitMessageTopic": "@nickknissen/m3-vue"
    }
  ]
}
